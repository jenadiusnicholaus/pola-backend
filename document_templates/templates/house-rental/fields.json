    {
      "name": "Contacts",
      "name_sw": "Mawasiliano",
      "order": 11,
      "fields": [
        {
          "field_name": "landlord_phone",
          "label_en": "Landlord phone number",
          "label_sw": "Namba ya Simu ya Mwenye Nyumba",
          "field_type": "phone",
          "is_required": true,
          "validation_rules": {
            "pattern": "^\\+?[0-9\\s\\-]{9,20}$"
          }
        },
        {
          "field_name": "tenant_phone",
          "label_en": "Tenant phone number",
          "label_sw": "Namba ya Simu ya Mpangaji",
          "field_type": "phone",
          "is_required": true,
          "validation_rules": {
