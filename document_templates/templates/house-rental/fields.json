          "label_sw": "Matumizi yasiyoruhusiwa 1 (hiari)",
          "field_type": "dropdown",
          "is_required": false,
          "options": [
            "residential",
            "office",
            "business"
          ],
          "options_sw": [
            "makazi",
            "ofisi",
            "biashara/shughuli za kibiashara"
          ]
        },
        {
          "field_name": "prohibited_use_2",
          "label_en": "Prohibited use 2 (optional)",
          "label_sw": "Matumizi yasiyoruhusiwa 2 (hiari)",
          "field_type": "dropdown",
          "is_required": false,
          "options": [
            "residential",
            "office",
            "business"
          ],
          "options_sw": [
            "makazi",
            "ofisi",
            "biashara/shughuli za kibiashara"
          ]
        },
        {
          "field_name": "prohibited_use_3",
          "label_en": "Prohibited use 3 (optional)",
          "label_sw": "Matumizi yasiyoruhusiwa 3 (hiari)",
          "field_type": "dropdown",
          "is_required": false,
          "options": [
            "residential",
            "office",
            "business"
          ],
          "options_sw": [
            "makazi",
            "ofisi",
            "biashara/shughuli za kibiashara"
          ]
        }
      ]
    },
    {
      "name": "Termination",
      "name_sw": "Usitishaji wa Makubaliano",
      "order": 9,
      "fields": [
        {
          "field_name": "tenant_notice_days",
          "label_en": "Days' notice the Tenant must give to terminate",
          "label_sw": "Notisi ya siku ngapi Mpangaji atoe kusitisha",
          "field_type": "number",
          "is_required": true,
          "validation_rules": {
            "min": 1,
            "max": 365
          }
        },
        {
          "field_name": "landlord_notice_days",
          "label_en": "Days' notice the Landlord must give (valid reason)",
          "label_sw": "Notisi ya siku ngapi Mwenye Nyumba atoe (sababu halali)",
          "field_type": "number",
          "is_required": true,
          "validation_rules": {
            "min": 1,
            "max": 365
          }
        },
        {
          "field_name": "termination_compensation",
          "label_en": "Compensation payable on termination (TZS)",
          "label_sw": "Fidia ya kusitishwa kwa mkataba (TZS)",
          "field_type": "text",
          "is_required": true
        }
      ]
    },
    {
      "name": "Additional Terms",
      "name_sw": "Masharti ya Ziada",
      "order": 10,
      "fields": [
        {
          "field_name": "additional_term_1",
          "label_en": "Additional term 1",
          "label_sw": "Sharti la ziada 1",
          "field_type": "text",
