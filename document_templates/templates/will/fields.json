{
  "sections": [
    {
      "name": "Testator Details",
      "name_sw": "Taarifa za Mtoa Wosia",
      "order": 1,
      "fields": [
        {
          "field_name": "testator_name",
          "label_en": "Full name of the testator",
          "label_sw": "Jina kamili la mtoa wosia",
          "field_type": "text",
          "is_required": true
        },
        {
          "field_name": "testator_po_box",
          "label_en": "P.O. Box",
          "label_sw": "S.L.P",
          "field_type": "text",
          "is_required": true
        },
        {
          "field_name": "testator_region",
          "label_en": "Region",
          "label_sw": "Mkoa",
          "field_type": "text",
          "is_required": true
        },
        {
          "field_name": "testator_id_number",
          "label_en": "Identification number",
          "label_sw": "Namba ya kitambulisho",
          "field_type": "text",
          "is_required": true
        },
        {
          "field_name": "testator_id_type",
          "label_en": "Type of identification",
          "label_sw": "Aina ya kitambulisho",
          "field_type": "dropdown",
          "is_required": true,
          "options": [
            "national_id",
            "passport",
            "voter_id",
            "driving_license"
          ],
          "options_sw": [
            "kitambulisho cha taifa",
            "pasi ya kusafiria",
            "kitambulisho cha mpiga kura",
            "leseni ya udereva"
          ]
        },
        {
          "field_name": "testator_dob",
          "label_en": "Date of birth",
          "label_sw": "Tarehe ya kuzaliwa",
          "field_type": "date",
          "is_required": true
        }
      ]
    },
